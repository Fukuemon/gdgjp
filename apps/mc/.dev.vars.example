# Secrets — set as production secrets with `wrangler secret put <NAME>`.
# HMAC key for the RP's signed session + OIDC transaction cookies.
# Generate with `openssl rand -base64 48`.
RP_SESSION_SECRET=""
# Client secret issued by the accounts IdP for this RP. Must equal the value set
# as MC_CLIENT_SECRET on the accounts worker.
IDP_CLIENT_SECRET=""
# Optional. Gemini API key used to transcribe uploaded clips; leave empty to
# type the text by hand in the upload form.
GEMINI_API_KEY=""

# Override prod URLs from wrangler.toml so dev points at the local accounts IdP.
APP_URL=http://localhost:5187
ACCOUNTS_URL=http://localhost:5173
IDP_URL=http://localhost:5173
IDP_CLIENT_ID=mc
# Enables /dev/login locally (it 404s when ENVIRONMENT === "production").
ENVIRONMENT=development
